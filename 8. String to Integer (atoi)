class Solution {
public:
    const long long INT_MAX_VAL = 2147483647LL;
    const long long INT_MIN_VAL = 2147483648LL;
    
    int helper(const string &s, int i, long long num, int sign) {
        if (i >= s.length() || !isdigit(s[i])) {
            if (sign == 1) {
                return num > INT_MAX_VAL ? INT_MAX_VAL : (int)num;
            } else {
                return num >= INT_MIN_VAL ? -2147483648 : (int)(-num); 
            }
        }

        if (sign == 1 && num > (INT_MAX_VAL - (s[i] - '0')) / 10) {
            return INT_MAX_VAL;
        }
        if (sign == -1 && num > (INT_MIN_VAL - (s[i] - '0')) / 10) {
            return -2147483648;
        }

        num = num * 10 + (s[i] - '0');

        return helper(s, i + 1, num, sign);
    }
    
    int myAtoi(string s) {
        int n = s.size();
        int i = 0;
        
        while (i < n && s[i] == ' ') {
            i++;
        }
        
        int sign = 1;
        if (i < n && (s[i] == '+' || s[i] == '-')) {
            sign = (s[i] == '-') ? -1 : 1;
            i++;
        }
        
        while (i < n && s[i] == '0') {
            i++;
        }
        
        if (i >= n || !isdigit(s[i])) {
            return 0;
        }
        
        return helper(s, i, 0LL, sign);
    }
};
