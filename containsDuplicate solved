class Solution {
    public boolean containsDuplicate(int[] nums) {
        HashMap<Integer,Boolean> mpp = new HashMap<>();
        for(int i=0;i<nums.length;i++){
            if(Boolean.TRUE.equals(mpp.get(nums[i]))){
                return true;
            }
            mpp.put(nums[i],true);
        }
        return false;
    }
}
