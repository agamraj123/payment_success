Coin Change 1 Solution:
class Solution {
public:
int solve(int ind,int a,vector<int>&coins,vector<vector<int>>&dp){
if(ind==coins.size()-1){
    if(a%coins[ind]==0) return a/coins[ind];
    return 1e9;
}
if(dp[ind][a]!=-1) return dp[ind][a];
// pick
int pick = 1e9;
if(coins[ind]<=a){
pick = 1 + solve(ind,a-coins[ind],coins,dp);
}

// notpick
int notpick = 0 + solve(ind+1,a,coins,dp);

return dp[ind][a] = min(pick,notpick);
}
    int coinChange(vector<int>& coins, int amount) {
        int n = coins.size();
        vector<vector<int>> dp(n,vector<int>(amount+1,-1));
        int ans = solve(0,amount,coins,dp);
        return ans>=1e9 ? -1 : ans;
    }
};

Coin change 2 solution
class Solution {
public:
int solve(int ind,int a,vector<int>&coins,vector<vector<int>> &dp){
    if(a==0) return 1;
    if(a<0 || ind<0) return 0;
    if(dp[ind][a]!=-1) return dp[ind][a];
    int pick = solve(ind,a-coins[ind],coins,dp);
    int notpick = solve(ind-1,a,coins,dp);

    return dp[ind][a] = pick+notpick;
}
    int change(int amount, vector<int>& coins) {
        int n = coins.size();
        vector<vector<int>> dp(n,vector<int>(amount+1,-1));
        return solve(n-1,amount,coins,dp);
    }
};
